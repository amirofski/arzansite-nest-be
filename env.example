# Supabase Configuration
SUPABASE_URL=https://api.arzansite.com
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_JWKS_URL=https://api.arzansite.com/auth/v1/keys

# Database (optional - if using direct PostgreSQL connection)
DATABASE_URL=postgres://postgres:password@localhost:5432/arzansite

# Frontend and CORS
FRONTEND_URL=https://arzansite.com
CORS_ORIGINS=https://arzansite.com,http://localhost:8080,http://localhost:5173

# Payment Gateway
ZARINPAL_MERCHANT_ID=your_merchant_id_here

# Application
NODE_ENV=production
PORT=3000

# JWT Settings
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1h

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
