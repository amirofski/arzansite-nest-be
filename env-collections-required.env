# Appwrite Configuration
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6898b35e003067cd7b43
APPWRITE_API_KEY=your_api_key_here
APPWRITE_DATABASE_ID=6899993d001b0b35b6b5

# Collection IDs - Required by Backend
# Core Collections
APPWRITE_COLLECTION_USERS=users
APPWRITE_COLLECTION_ORDERS=orders
APPWRITE_COLLECTION_PAYMENTS=payments
APPWRITE_COLLECTION_WIZARD_SESSIONS=wizard_sessions
APPWRITE_COLLECTION_PROJECT_FILES=project_files
APPWRITE_COLLECTION_NOTIFICATIONS=notifications
APPWRITE_COLLECTION_USER_PROFILES=user_profiles
APPWRITE_COLLECTION_SUPPORT_TICKETS=support_tickets
APPWRITE_COLLECTION_AUDIT_LOGS=audit_logs
APPWRITE_COLLECTION_SYSTEM_SETTINGS=system_settings

# Auth & Security Collections
APPWRITE_COLLECTION_AUTH_TOKENS=auth_tokens

# Financial Collections
APPWRITE_COLLECTION_INVOICES=invoices
APPWRITE_COLLECTION_RECEIPTS=receipts
APPWRITE_COLLECTION_WALLETS=wallets
APPWRITE_COLLECTION_TRANSACTIONS=transactions

# Design Collections
APPWRITE_COLLECTION_DESIGNS=designs

# Storage Buckets
APPWRITE_STORAGE_PROJECT_FILES=project_files
APPWRITE_STORAGE_USER_AVATARS=user_avatars
APPWRITE_STORAGE_DESIGN_ASSETS=design_assets

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Configuration
FRONTEND_URL=https://arzansite.com

# Payment Gateway
ZARINPAL_MERCHANT_ID=your_merchant_id_here

# Email Configuration
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@arzansite.com

# Cookie Configuration (for production)
COOKIE_DOMAIN=.arzansite.com
NODE_ENV=production
