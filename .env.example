# Storage buckets mapping (read by appwriteService.getConfig())
# Example JSON in your config setup; ensure buckets are created in Appwrite Storage.
# { "buckets": { "document": "<bucketId>", "design": "<bucketId>", "avatar": "<bucketId>" } }

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SENDER_NAME=ArzanSite
SMTP_SECURITY=starttls

# Frontend URL for callbacks
FRONTEND_URL=

# ZarinPal
ZARINPAL_MERCHANT_ID=
