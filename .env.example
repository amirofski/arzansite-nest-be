# Appwrite
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=

# Collections (override defaults if you use custom IDs)
APPWRITE_COLLECTION_USER_PROFILES=
APPWRITE_COLLECTION_WALLETS=
APPWRITE_COLLECTION_TRANSACTIONS=
APPWRITE_COLLECTION_ORDERS=
APPWRITE_COLLECTION_PAYMENTS=
APPWRITE_COLLECTION_INVOICES=
APPWRITE_COLLECTION_RECEIPTS=
APPWRITE_COLLECTION_NOTIFICATIONS=
APPWRITE_COLLECTION_NOTIFICATION_PREFERENCES=
APPWRITE_COLLECTION_WIZARD_SESSIONS=
APPWRITE_COLLECTION_DESIGNS=
APPWRITE_COLLECTION_SITE_CONFIG=
APPWRITE_COLLECTION_EMAIL_LOGS=
APPWRITE_COLLECTION_PUSH_TOKENS=
